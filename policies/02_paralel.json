{
  "policyName": "tckn_paralel_oob",
  "displayName": "TCKN + Paralel OOB",
  "appLabel": "Bireysel Portal",
  "description": "TCKN sorgu, sonra aynı ekranda SMS + Email kodu",
  "sessionMinutes": 30,
  "stages": [
    {
      "step": 1,
      "parallel": false,
      "timing": { "mode": "perStage" },
      "items": [
        {
          "type": "tckn_standalone",
          "config": {
            "inputField": "tckn",
            "inputLabel": "TC Kimlik No",
            "validation": "\\d{11}",
            "timeout": 120,
            "maxRetries": 3
          }
        }
      ]
    },
    {
      "step": 2,
      "parallel": true,
      "timing": { "mode": "perStage" },
      "items": [
        {
          "type": "sms_oob",
          "config": {
            "otpLength": 6,
            "timeout": 60,
            "maxRetries": 3
          }
        },
        {
          "type": "email_oob",
          "config": {
            "otpLength": 6,
            "timeout": 180,
            "maxRetries": 3
          }
        }
      ]
    }
  ]
}
